---
import PageLayout from '../layouts/PageLayout.astro';
---

<!--
  Phase 1 placeholder — verifies the foundation (nav, footer, design tokens,
  fonts, layout) all render correctly before building real page sections.
  Replace with the real home page in Phase 4.
-->
<PageLayout transparentNav>
	<!-- Tall hero area so we can verify the transparent → scrolled nav transition -->
	<section
		class="min-h-screen flex flex-col items-center justify-center text-center bg-surface px-6"
	>
		<p class="text-sm font-body uppercase tracking-widest text-muted mb-6">
			Fraser Embrey Photography
		</p>
		<h1 class="font-display text-5xl md:text-7xl text-ink leading-none mb-8">
			Site in progress
		</h1>
		<p class="font-body text-base text-muted max-w-sm mb-10 leading-relaxed">
			A new portfolio is on its way. In the meantime, get in touch via Instagram.
		</p>
		<a href="/work" class="btn-ghost">View work</a>
	</section>

	<!-- Spacer to allow scrolling and test the nav scroll transition -->
	<section class="min-h-screen flex items-center justify-center">
		<div class="wrap text-center">
			<h2 class="font-display text-3xl md:text-5xl text-ink mb-4">
				Events. Sport. Story.
			</h2>
			<p class="font-body text-muted max-w-md mx-auto">
				Capturing decisive moments at events across the UK.
			</p>
		</div>
	</section>
</PageLayout>
